{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A Worker that only serves the built catalogue; there is no script.
  "name": "siyahi-catalogue",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "siyahi.jatinbansal.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
