{
  "name": "@siyahi/ui",
  "version": "0.1.4",
  "description": "Stock shadcn/ui on Base UI and Tailwind v4, a finance theme, a few compositions and formatters.",
  "keywords": [
    "base-ui",
    "design-system",
    "finance",
    "react",
    "shadcn",
    "tailwindcss"
  ],
  "homepage": "https://siyahi.jatinbansal.com",
  "license": "MIT",
  "author": "Jatin Bansal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jatinbansal1998/siyahi.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "styles",
    "report.css",
    "registry.lock.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles/siyahi.css",
    "./report.css": "./report.css",
    "./registry.lock.json": "./registry.lock.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../tools/contrast.mjs styles/siyahi.css && vp pack",
    "prepublishOnly": "echo 'Publishing what the check job built; no build here.'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "d3-hierarchy": "^3.1.2",
    "date-fns": "^4.4.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.59.0",
    "react-day-picker": "^10.0.2",
    "recharts": "3.8.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "catalog:",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "4.22.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0"
  }
}
