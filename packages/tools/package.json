{
  "name": "@siyahi/tools",
  "version": "0.1.9",
  "description": "Checks and build helpers for Siyahi pages: a lint plugin, a font preload plugin, a theme contrast check, and screenshot and layout shift scripts.",
  "homepage": "https://siyahi.jatinbansal.com",
  "license": "MIT",
  "author": "Jatin Bansal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jatinbansal1998/siyahi.git",
    "directory": "packages/tools"
  },
  "bin": {
    "siyahi-cls": "./cls.mjs",
    "siyahi-contrast": "./contrast.mjs",
    "siyahi-page": "./page.mjs",
    "siyahi-shots": "./shots.mjs"
  },
  "files": [
    "*.mjs",
    "lint/*.mjs",
    "types",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    "./lint": {
      "types": "./types/lint/index.d.mts",
      "default": "./lint/index.mjs"
    },
    "./contrast": {
      "types": "./types/contrast.d.mts",
      "default": "./contrast.mjs"
    },
    "./vite": {
      "types": "./types/vite.d.mts",
      "default": "./vite.mjs"
    },
    "./page": {
      "types": "./types/page.d.mts",
      "default": "./page.mjs"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "echo 'Publishing what the check job built; no build here.'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shadcn/lint": "0.2.3",
    "playwright": "^1.64.1",
    "vite-plugin-singlefile": "2.3.4"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/m-plus-1-code": "^5.3.1",
    "@siyahi/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "^1.88.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@tailwindcss/vite": ">=4.0.0",
    "@vitejs/plugin-react": ">=5.0.0",
    "oxlint": ">=1.80.0",
    "vite": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@tailwindcss/vite": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    }
  }
}
