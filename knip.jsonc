{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["vite.config.ts"],
    },
    "packages/ui": {
      "entry": ["src/index.ts", "scripts/generate.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
      // The shadcn CLI adds components; generate.ts copies its tailwind.css by path.
      "ignoreDependencies": ["shadcn"],
      // Copied shadcn and registry modules are kept whole, with every part
      // they export, so they can be compared with their origin.
      "ignoreIssues": {
        "src/components/ui/**": ["exports", "types", "duplicates"],
        "src/components/registry/**": ["exports", "types", "duplicates"],
      },
    },
    "packages/tools": {
      "entry": ["*.mjs", "lint/index.mjs", "test/**/*.test.mjs"],
      // The plugin's host; the lint tests run its binary by path.
      "ignoreDependencies": ["oxlint"],
    },
    "apps/catalogue": {
      // Examples are loaded with import.meta.glob.
      "entry": ["src/main.tsx", "src/examples/*.tsx"],
    },
  },
}
